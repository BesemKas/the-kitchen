Options -Indexes
DirectoryIndex index.php

# Force HTTPS (the barcode camera only works over HTTPS)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block dotfiles, SQL and markdown from being downloaded
<FilesMatch "(^\.|\.(sql|md|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Label reader files (assets/ocr): compressed on the way out, cached for a year (they never change in place)
<IfModule mod_deflate.c>
    <FilesMatch "\.(js|traineddata)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(traineddata|wasm\.js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
